# ==========================================================
# dr.PdF v2 — Environment Configuration
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==========================================================

# Required for server-side Google Gemini AI generation.
# Get a free API key at: https://aistudio.google.com/apikey
# IMPORTANT: Never prefix this with NEXT_PUBLIC_ — it must stay server-only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Override default active Flash model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
